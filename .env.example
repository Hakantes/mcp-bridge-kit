# MCP-Bridge-Kit Configuration
# MCP-Bridge-Kit is 100% self-contained with zero required external API keys.

# Allowed sandbox root directory for filesystem operations (default: current working directory)
MCP_SANDBOX_ROOT=.

# Execution timeout in seconds for shell command tools (default: 10)
MCP_EXEC_TIMEOUT_SECONDS=10

# Stdio logging verbosity: stderr only (to prevent stdio protocol channel corruption)
MCP_LOG_LEVEL=INFO
